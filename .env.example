# WhatsApp Bot Configuration

# Node Environment
NODE_ENV=development
PORT=3000

# Twilio Configuration (WhatsApp Cloud API)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_TOKEN=your_webhook_verification_token

# LIS API Configuration
LIS_API_BASE_URL=https://lis.diagnosticschain.com/api
LIS_API_KEY=your_lis_api_key
LIS_API_TIMEOUT_MS=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=diagnobot_user
DB_PASSWORD=secure_password
DB_NAME=diagnobot_prod

# Security
ENCRYPTION_KEY=your_32_char_encryption_key_here
JWT_SECRET=your_jwt_secret_key
SESSION_TIMEOUT_MS=1800000
OTP_VALIDITY_MS=300000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# HIPAA Compliance
HIPAA_AUDIT_RETENTION_DAYS=90
ENABLE_AUDIT_LOGGING=true
