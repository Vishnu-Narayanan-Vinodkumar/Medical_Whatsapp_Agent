NODE_ENV=development
PORT=3000
DATA_MODE=sample
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional external PostgreSQL; otherwise embedded PostgreSQL is used locally.
DATABASE_URL=
DATA_DIR=

# Live mode requires a 64-character hex encryption key, email delivery, and origin.
ENCRYPTION_KEY=
APP_ORIGIN=
SMTP_URL=
MAIL_FROM=
SUPPORT_PHONE=

# Configure only after LIS identity/access review and provider approval.
LIS_API_BASE_URL=
LIS_API_KEY=
REPORT_DOWNLOAD_HOSTS=
CATALOGUE_FILE=
GROQ_LIVE_APPROVED=false

# Beta conversation uses the existing Groq key and model.
BETA_ASSISTANT=true
# Up to three public HTML pages approved by the operator. [] disables retrieval.
WEB_SOURCES=["https://www.nhs.uk/tests-and-treatments/blood-tests/"]

# demo simulates payment locally; stripe uses hosted Checkout; disabled takes no payment.
# Sample data permits only demo or Stripe test keys. Never put secrets in browser files.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=